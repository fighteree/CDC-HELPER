<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yzdbx.cdc.mapper.DataSourceMapper">

    <resultMap id="DataSourceMap" type="com.yzdbx.cdc.model.entity.DataSourceEntity">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="db_type" property="dbType"/>
        <result column="host" property="host"/>
        <result column="port" property="port"/>
        <result column="db_name" property="dbName"/>
        <result column="jdbc_url" property="jdbcUrl"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, db_type, host, port, db_name, jdbc_url, username, password, status, remark, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.yzdbx.cdc.model.entity.DataSourceEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cdc_data_source
        (name, db_type, host, port, db_name, jdbc_url, username, password, status, remark)
        VALUES
        (#{name}, #{dbType}, #{host}, #{port}, #{dbName}, #{jdbcUrl}, #{username}, #{password}, #{status}, #{remark})
    </insert>

    <update id="update" parameterType="com.yzdbx.cdc.model.entity.DataSourceEntity">
        UPDATE cdc_data_source
        SET
            name = #{name},
            db_type = #{dbType},
            host = #{host},
            port = #{port},
            db_name = #{dbName},
            jdbc_url = #{jdbcUrl},
            username = #{username},
            password = #{password},
            status = #{status},
            remark = #{remark}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM cdc_data_source WHERE id = #{id}
    </delete>

    <select id="selectById" resultMap="DataSourceMap">
        SELECT <include refid="Base_Column_List"/>
        FROM cdc_data_source
        WHERE id = #{id}
    </select>

    <sql id="Where_List">
        <where>
            <if test="keyword != null and keyword != ''">
                (name LIKE CONCAT('%', #{keyword}, '%')
                 OR db_name LIKE CONCAT('%', #{keyword}, '%')
                 OR host LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="dbType != null and dbType != ''">
                AND db_type = #{dbType}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectAll" resultMap="DataSourceMap">
        SELECT <include refid="Base_Column_List"/>
        FROM cdc_data_source
        <include refid="Where_List"/>
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByCondition" resultType="int">
        SELECT COUNT(*) FROM cdc_data_source
        <include refid="Where_List"/>
    </select>

</mapper>

